#include <iostream>
#include <cstring>
using namespace std;

class String
{
    char str[100];

public:
    // Default constructor
    String()
    {
        strcpy(str, "");
    }

    // Parameterized constructor
    String(char s[])
    {
        strcpy(str, s);
    }

    // Accept string
    void Accept()
    {
        cout << "Enter a string: ";
        cin.getline(str, 100);
    }

    // Display string
    void Display()
    {
        cout << "String: " << str << endl;
    }

    // Destructor
    ~String()
    {
        cout << "Destructor called" << endl;
    }
};

int main()
{
    String s1;
    s1.Accept();
    s1.Display();

    String s2("Hello World");
    s2.Display();

    return 0;
}

