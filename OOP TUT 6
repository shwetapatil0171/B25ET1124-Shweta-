#include <iostream>
using namespace std;

class Complex
{
    float real, imag;

public:
    // Constructor
    Complex(float r = 0, float i = 0)
    {
        real = r;
        imag = i;
    }

    // Overloading * operator
    Complex operator*(Complex c)
    {
        Complex temp;

        temp.real = (real * c.real) - (imag * c.imag);
        temp.imag = (real * c.imag) + (imag * c.real);

        return temp;
    }

    // Display function
    void display()
    {
        cout << real << " + " << imag << "i";
    }
};

int main()
{
    Complex c1(3, 2);
    Complex c2(4, 5);

    Complex c3 = c1 * c2;

    cout << "First complex number: ";
    c1.display();

    cout << "\nSecond complex number: ";
    c2.display();

    cout << "\nProduct: ";
    c3.display();

    return 0;
}
