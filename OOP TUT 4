#include <iostream>
using namespace std;

class Numbers
{
    int real, img;

public:
    void getdata()
    {
        cout << "Enter real part: ";
        cin >> real;

        cout << "Enter imaginary part: ";
        cin >> img;
    }

    void display()
    {
        if (img >= 0)
            cout << real << " + " << img << "i" << "\n";
        else
            cout << real << " - " << -img << "i" << "\n";
    }

    Numbers multiply(Numbers n)
    {
        Numbers temp;
        temp.real = (real * n.real) - (img * n.img);
        temp.img = (real * n.img) + (img * n.real);
        return temp;
    }
};

int main()
{
    Numbers n1, n2, result;

    cout << "Enter first complex number:\n";
    n1.getdata();

    cout << "\nEnter second complex number:\n";
    n2.getdata();

    result = n1.multiply(n2);

    cout << "Multiplication = ";
    result.display();

    return 0;
}




